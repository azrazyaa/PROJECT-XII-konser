# Copy these settings into Backend/.env.local. Never commit real keys.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-your-sandbox-server-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-sandbox-client-key

# Configure this public HTTPS endpoint in Midtrans Dashboard > Settings > Configuration:
# https://your-public-backend-host/api/payments/midtrans/notification
